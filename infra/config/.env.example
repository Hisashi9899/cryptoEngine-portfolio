# CryptoEngine Configuration

# Exchange
# core REST クライアント（/api/v1/ticker）。Binance 公開 REST。
# 地域制限で 451 になる場合は https://data-api.binance.vision を使用。
EXCHANGE_BASE_URL=https://api.binance.com
# ticker エンドポイント（デフォルト /api/v3/ticker/24hr）
EXCHANGE_TICKER_PATH=/api/v3/ticker/24hr

# Core (Go)
CORE_LOG_LEVEL=info
CORE_REQUEST_TIMEOUT=10s

# Exchange selection (core)
# EXCHANGE_ID=gmo で GMO コインを使用（market data / capture / execute-order）。
# 未設定・binance は従来通り Binance。GMO 選択時は EXCHANGE_BASE_URL /
# EXCHANGE_TICKER_PATH（Binance 用）は無視される。
EXCHANGE_ID=binance

# GMO coin (auto trading + market data)
# GMO の API キー・シークレットを設定する（Private API の発注・約定照会用）。
# 旧変数 BINANCE_API_KEY / BINANCE_API_SECRET も後方互換として参照されるが、
# 新規は GMO_* を使うこと。値は .env / .env.prod にのみ記載する。
GMO_API_KEY=
GMO_API_SECRET=
# GMO_MAINTENANCE_CHECK=off で定期メンテ時間帯（土曜 09:00-11:00 JST）の
# 発注拒否を無効化できる（テスト用。本番では設定しないこと）。
# 現物の銘柄別最小数量・刻み（/public/v1/symbols 実測・2026-09-15）。
# シンボルは短縮形（BTC）。「_JPY」はレバレッジ指定になるため使わないこと。
#   BTC 最小 0.00001（約 120 円〜）、ETH 最小 0.001、XRP 最小 1（約 220 円〜）。
# 5,000 円口座でも BTC 最小ロットから検証可能。

# Binance (auto trading, legacy)
# GMO_* 未設定時のみ参照されるフォールバック。中身が GMO キーでも動作するが非推奨。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Auto Trade
# v1/Binance 系の既定（USDT 建て）。trader（GMO 現物・JPY 建て）は
# compose の trader サービス環境で上書きする（例: 2200/20000/2000 JPY）。
# 変数名の _USDT は歴史的経緯。JPY 運用時は JPY 額面として解釈し、
# engine 内換算レート JPYPerUSDT=150 で USDT 照合する。
AUTO_TRADE_ENABLED=false
MAX_POSITION_SIZE_USDT=100
MAX_DAILY_LOSS_USDT=20
STOP_ON_LOSS=true
TRADE_SIZE_USDT=50
TRADE_LOG_PATH=backend/core/trade_logs/trade_log.csv

# Signal Filters (trading)
# 解析結論（2026-08-08）: cooldown は利益を単調減少（有害）、confidence gate / volatility は
# 検証データでは効果なし。デフォルトは無効（コード既定値と同じ）。VPS は無効で起動し実データで再検証する。
# CRYPTOENGINE_CONFIDENCE_GATE: 確信度ゲート（0 で無効, 0-1）
CRYPTOENGINE_CONFIDENCE_GATE=0
# CRYPTOENGINE_VOLATILITY_WINDOW: 移動標準偏差の window（未設定=無効）。
#   注意: env で 0 を指定しても clamp され window=5 になり「無効化」されない。無効化はキー未設定。
# CRYPTOENGINE_VOLATILITY_THRESHOLD: 相対標準偏差の閾値（0.0005-0.05）
# CRYPTOENGINE_COOLDOWN_SECONDS: 同一シンボルの再発火を抑止する秒数（0 で無効, 0-300）
CRYPTOENGINE_COOLDOWN_SECONDS=0

# Authentication (JWT)
# AUTH_SECRET は必ず長いランダム値を生成して設定すること（例: openssl rand -hex 32）。
# 未設定での本番起動は禁止（開発時は警告が出て dev 用デフォルトが使われる）。
AUTH_SECRET=
# Local demo only: allow the built-in development JWT secret when AUTH_SECRET is empty.
# The API refuses this fallback when APP_ENV=prod. Never enable it in production.
AUTH_ALLOW_DEV_SECRET=1
JWT_ACCESS_TTL_HOURS=1
JWT_REFRESH_TTL_DAYS=30
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_EMAIL=admin@example.com
# 実パスワードを example に書かないこと。強力な値を生成して .env / .env.prod に記載する。
AUTH_ADMIN_PASSWORD=

# Login rate limiting (IP 単位 + アカウント単位の二重制限)
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SEC=900
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=20
AUTH_LOGIN_ACCOUNT_WINDOW_SEC=3600

# API (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
CORE_BIN_PATH=/app/core
# Local dashboard preview: 1 = deterministic demo balance/trades/signals when
# the database is empty. Never enable this in production.
DEMO_DATA_ENABLED=0

# App environment (dev または prod。prod では起動時に DB パスワード強度を検証する)
APP_ENV=dev

# Database (PostgreSQL)
# compose 運用時は DB_URL が唯一のオーソリティ（api/core とも DB_URL 優先）。
# 本番用は強ランダム値にすること（例: openssl rand -base64 24）。
# POSTGRES_PASSWORD と DB_URL 内のパスワードは必ず同じ値に保つこと。
DB_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=crypto
DB_PASSWORD=
DB_NAME=crypto_engine
POSTGRES_USER=crypto
POSTGRES_PASSWORD=
POSTGRES_DB=crypto_engine
