# cryptoEngine ops — collection settings
# Copy to config.env and fill in the values. config.env is gitignored (contains hosts/keys).

# VPS
VPS_HOST="your.vps.example.com"
SSH_PORT=22

# SSH
COLLECT_USER="cryptoengine-collect"
SSH_KEY="${OPS_ROOT:-/opt/cryptoengine/ops}/keys/cryptoengine_ops"

# Where docker-compose lives on the VPS (root compose at COMPOSE_DIR/COMPOSE_FILE)
COMPOSE_DIR="/opt/cryptoengine"
COMPOSE_FILE="docker-compose.yml"

# Remote staging dir (the collect user must be able to write here)
STAGING_DIR="/var/lib/cryptoengine/staging"

# nginx (leave empty if not used)
NGINX_ACCESS_LOG="/var/log/nginx/access.log"
NGINX_ERROR_LOG="/var/log/nginx/error.log"

# Public endpoint checks
PROD_URL="https://app.example.com"
GLB_PATH="/models/bike.glb"
EXPECTED_GLB_SIZE=13827060

# API health URL (checked from inside the VPS, so localhost is fine)
API_HEALTH_URL="http://localhost:8000/health"
